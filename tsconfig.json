{
   "extends": "expo/tsconfig.base",
   "compilerOptions": {
      "jsx": "react-jsx",
      "strict": true,
      "paths": {
         "@app/*": [
            "./app/*"
         ],
         "@assets/*": [
            "./assets/*"
         ],
         "@/*": [
            "./src/*"
         ]
      }
   },
   "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.jsx",
      "**/*.js",
      ".expo/types/**/*.ts",
      "src/types/expo-env.d.ts",
      "expo-env.d.ts"
   ]
}